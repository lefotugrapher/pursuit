# Copy to .env.local and fill in. Never commit .env.local.
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
# Gmail: turn on 2-Step Verification, then create an app password at myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
# Optional
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
NTFY_URL=http://localhost:8091
NTFY_TOPIC=
# Telegram bot from @BotFather (questions, updates, email approvals). Pair it from Settings.
TELEGRAM_BOT_TOKEN=
# Free models only. Paid models are refused unless LLM_ALLOW_PAID=1.
LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free
LLM_ALLOW_PAID=0
# Fallbacks used in order when OpenRouter's daily free cap is hit: Gemini, Groq (only if keyed), then local Ollama.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Local Ollama: OFF unless LLM_LOCAL=1 (Kayzee doesn't want local compute used; free online providers first).
# LLM_LOCAL=
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3-14b-abl:latest
# Optional private search (set automatically in Docker)
SEARXNG_URL=

# Optional, PAID: Claude for apply-time writing only (CV, cover letter, form answers). Everything else stays on the
# free models. Spend stops at the caps below and falls back to the free models.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# LLM_PREMIUM_DAILY_USD=3
# LLM_PREMIUM_TOTAL_USD=90
